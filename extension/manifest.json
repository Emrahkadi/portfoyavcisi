{
  "manifest_version": 3,
  "name": "Leadseak - Emlak Lead Avcısı",
  "version": "1.0.0",
  "description": "Sahibinden'deki günlük ilanları portföyünüze ekleyin. AI analiz ve WhatsApp mesajı otomatik hazırlanır.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.sahibinden.com/*",
    "https://leadseak.com/*",
    "https://www.leadseak.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.sahibinden.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}