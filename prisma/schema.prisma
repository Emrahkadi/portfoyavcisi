// Prisma Schema - Gayrimenkul Portföy Kazanım Platformu
// Lead Intelligence & CRM sistemi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// KULLANICI & ORGANIZASYON
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole  @default(AGENT)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  leads         Lead[]    @relation("AssignedAgent")
  messages      Message[]
  appointments  Appointment[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([organizationId])
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  kvkkConsent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  listings  Listing[]
  leads     Lead[]
}

// ============================================================
// BÖLGE / EMSAL VERİSİ
// ============================================================

model District {
  id          String   @id @default(cuid())
  city        String
  district    String
  neighborhood String?
  // Emsal istatistikleri (m² başına TL)
  medianPricePerSqm Float?
  avgPricePerSqm   Float?
  minPricePerSqm   Float?
  maxPricePerSqm   Float?
  sampleSize       Int      @default(0)
  lastComputedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings    Listing[]

  @@unique([city, district, neighborhood])
  @@index([city, district])
}

// ============================================================
// İLAN (DATA SOURCE AGNOSTIC)
// ============================================================

model Listing {
  id              String        @id @default(cuid())
  externalId      String        // Kaynak sistemdeki ID (Sahibinden, Hepsiemlak, manual...)
  source          ListingSource
  url             String?
  title           String
  description     String?
  propertyType    PropertyType
  rooms           String?       // "2+1", "3+1" gibi
  sizeSqm         Float
  price           Float
  pricePerSqm     Float
  city            String
  district        String
  neighborhood    String?
  fullAddress     String?
  latitude        Float?
  longitude       Float?
  floor           Int?
  buildingAge     Int?
  heatingType     String?
  furnished       Boolean       @default(false)
  isOwner         Boolean       @default(false)  // Sahibinden mi, emlakçı mı
  daysOnMarket    Int           @default(0)
  priceHistory    Json?         // [{date, price}, ...]
  viewCount       Int           @default(0)
  contactPhone    String?
  contactName     String?
  rawData         Json?         // Kaynak sistemin ham verisi
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  districtId      String?
  districtRef     District?     @relation(fields: [districtId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // AI değerlendirme
  aiScore         Float?        // 0-100 arası potansiyel skoru
  aiAnalysis      Json?         // AI'ın detaylı analizi
  aiReasons       String[]      // Neden bu skor verildi
  aiEvaluatedAt   DateTime?

  // Lead ilişkisi
  lead            Lead?

  @@unique([source, externalId])
  @@index([city, district])
  @@index([source])
  @@index([aiScore])
  @@index([organizationId])
}

enum ListingSource {
  SAHIBINDEN       // Manuel import (ToS uyumlu)
  HEPSIEMLAK       // Manuel import
  MANUAL           // Kullanıcının kendi eklediği
  CSV_IMPORT       // CSV dosyasından
  API_PARTNER      // Resmi API partner
  OTHER
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  OFFICE
  LAND
  COMMERCIAL
  OTHER
}

// ============================================================
// LEAD (SATICI ADAYI)
// ============================================================

model Lead {
  id              String      @id @default(cuid())
  listingId       String      @unique
  listing         Listing     @relation(fields: [listingId], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  assignedAgentId String?
  assignedAgent   User?       @relation("AssignedAgent", fields: [assignedAgentId], references: [id])

  // İletişim
  contactPhone    String
  contactName     String?
  contactEmail    String?

  // Lead scoring
  status          LeadStatus  @default(NEW)
  score           Int         @default(0)  // 0-100
  temperature     LeadTemp    @default(COLD)
  priority        Int         @default(0)  // 1-5

  // KVKK / Onay
  consentGiven    Boolean     @default(false)
  consentDate     DateTime?
  consentMethod   String?     // "whatsapp_opt_in", "verbal", "written"
  optOutDate      DateTime?

  // AI değerlendirme
  aiSummary       String?
  aiNextAction    String?

  // Tarihler
  firstContactAt  DateTime?
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  closedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  messages        Message[]
  appointments    Appointment[]
  notes           LeadNote[]

  @@index([status])
  @@index([temperature])
  @@index([score])
  @@index([assignedAgentId])
  @@index([organizationId])
}

enum LeadStatus {
  NEW              // Yeni lead
  CONTACTED        // İlk temas kuruldu
  ENGAGED          // Görüşme devam ediyor
  APPOINTMENT_SET  // Randevu alındı
  NEGOTIATING      // Pazarlık
  WON              // Portföy kazanıldı
  LOST             // Kaybedildi
  OPT_OUT          // İletişim istemiyor
  ARCHIVED
}

enum LeadTemp {
  COLD             // ❌ Kapalı
  WARM             // 🟡 Takip
  HOT              // 🟢 Sıcak
  URGENT           // 🔥 Acil lead
}

// ============================================================
// MESAJLAŞMA
// ============================================================

model Message {
  id            String      @id @default(cuid())
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  direction     MessageDirection
  channel       MessageChannel  @default(WHATSAPP)
  content       String
  // AI analizi (gelen mesajlar için)
  aiCategory    MessageCategory?
  aiSentiment   Float?      // -1 ile 1 arası
  aiIntent      String?
  aiConfidence  Float?
  // Meta verileri
  externalId    String?     // WhatsApp message ID
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime    @default(now())

  @@index([leadId])
  @@index([direction])
  @@index([aiCategory])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageChannel {
  WHATSAPP
  SMS
  PHONE
  EMAIL
  IN_PERSON
}

enum MessageCategory {
  REJECTION       // "Emlakçı istemiyorum"
  COMMISSION      // "Komisyon vermem"
  INTERESTED      // "Alıcınız varsa getirin"
  APPOINTMENT     // "Yarın görüşebiliriz"
  INFO_REQUEST    // Bilgi talebi
  PRICE_INQUIRY   // Fiyat sorusu
  OTHER
}

// ============================================================
// RANDEVU
// ============================================================

model Appointment {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  scheduledAt DateTime
  durationMin Int       @default(30)
  location    String?
  notes       String?
  status      AppointmentStatus @default(SCHEDULED)
  outcome     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scheduledAt])
  @@index([leadId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// ============================================================
// LEAD NOTLARI
// ============================================================

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ============================================================
// AUDIT LOG (KVKK & Compliance)
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // "lead.created", "message.sent", "data.exported"
  entity    String   // "Lead", "Message", "Listing"
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// DATA SOURCE CONFIG (Hangi kaynaklardan veri çekilecek)
// ============================================================

model DataSourceConfig {
  id          String   @id @default(cuid())
  name        String
  type        ListingSource
  enabled     Boolean  @default(false)
  config      Json?    // Kaynak-spesifik konfigürasyon
  lastRunAt   DateTime?
  lastStatus  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}